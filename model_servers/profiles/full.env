# -------- full profile: H100, 80 GB (the architecture doc) --------
# Copy to ../.env :  cp profiles/full.env .env
# Qwen3-VL-30B FP8 via vLLM + SAM 3 + DINOv3. Use the `vllm` compose profile:
#   docker compose --profile vllm up -d vllm

MODEL_PROFILE=full

# ---- VLM via vLLM (HF-format FP8, not GGUF) ----------------------------------
VLLM_MODEL=/models/qwen3vl-30b-fp8
VLM_CTX=32768

# ---- llama.cpp VLM (unused in full profile, kept for parity) -----------------
VLM_MODEL=/models/vlm-27b/model.Q4_K_M.gguf
VLM_MMPROJ=/models/vlm-27b/mmproj-model-f16.gguf
VLM_NGL=99
VLM_PARALLEL=8

# ---- Perception ---------------------------------------------------------------
PERCEPTION_BACKEND=sam3
SAM_WEIGHTS=/models/sam3
DINOV3_WEIGHTS=/models/dinov3
SAMPLE_FPS=10

# ---- Offline ------------------------------------------------------------------
HF_HOME=/models/.hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
