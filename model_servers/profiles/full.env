# -------- full profile: H100, 80 GB (the architecture doc) --------
# Copy to ../.env :  cp profiles/full.env .env
# Qwen3-VL-30B FP8 via vLLM + SAM 3 + DINOv3. Use the `vllm` compose profile:
#   docker compose --profile vllm up -d vllm

MODEL_PROFILE=full

# ---- VLM via vLLM (HF-format, not GGUF) ---------------------------------------
# The BF16 checkpoint downloaded for local testing (models/qwen3-vl-30b-a3b-instruct/,
# ~58GB) works as-is on an 80GB H100 alongside SAM3+DINOv3 — no re-quantization
# needed, there's room for the full-precision weights.
VLLM_MODEL=/models/qwen3-vl-30b-a3b-instruct
VLM_CTX=32768

# ---- Optional standby VLM: Gemma 4 12B via llama.cpp (unused unless swapped) --
VLM_MODEL=/models/gemma4-12b/gemma-4-12b-it-UD-Q5_K_XL.gguf
VLM_MMPROJ=/models/gemma4-12b/mmproj-F16.gguf
VLM_NGL=99
VLM_PARALLEL=8

# ---- Perception ---------------------------------------------------------------
PERCEPTION_BACKEND=sam3
SAM_WEIGHTS=/models/sam3
DINOV3_WEIGHTS=/models/dinov3-vitl16
SAMPLE_FPS=10

# ---- Offline ------------------------------------------------------------------
HF_HOME=/models/.hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
