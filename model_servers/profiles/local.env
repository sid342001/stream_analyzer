# -------- local profile: RTX 5000 Ada, 32 GB --------
# Copy to ../.env :  cp profiles/local.env .env
# Primary VLM is Qwen3-VL via vLLM. SAM 3 + DINOv3 are hosted as their own
# container (perception-api) for now, since there's no backend process yet to
# import them in-process — see ../README.md §1.3 for why in-process is still
# the eventual target once backend/ exists.

MODEL_PROFILE=local

# ---- Primary VLM: Qwen3-VL-8B-FP8 via vLLM (HF-format, OpenAI API on :8080) --
# 8B, not 30B-A3B: the 30B-A3B checkpoint (even at official FP8, ~31GB) doesn't
# fit a 32GB card alongside SAM3+DINOv3 with any KV-cache/activation headroom.
# 8B-FP8 is ~9-10GB, leaving comfortable room. The 30B-A3B BF16 checkpoint is
# still on disk at models/qwen3-vl-30b-a3b-instruct/ — untouched, reserved for
# the `full` (H100) profile where 80GB has plenty of room for it as-is.
#   docker compose --profile vllm up -d vllm
VLLM_MODEL=/models/qwen3-vl-8b-instruct-fp8
VLM_CTX=32768

# ---- Optional standby VLM: Gemma 4 12B (encoder-free, GGUF+mmproj) -----------
# Hot-swappable alternative via llama.cpp, brought up only if/when you host it:
#   docker compose up -d vlm
# Do not run `vlm` and `vllm` at the same time — they share port 8080.
VLM_MODEL=/models/gemma4-12b/gemma-4-12b-it-UD-Q5_K_XL.gguf
VLM_MMPROJ=/models/gemma4-12b/mmproj-F16.gguf
VLM_NGL=99            # GPU layers; lower (e.g. 60) to offload to CPU RAM and free VRAM
VLM_PARALLEL=2        # concurrent request slots

# ---- Perception: SAM 3 + DINOv3 -----------------------------------------------
# Hosted today as its own container since there's no backend to import them
# in-process yet:
#   docker compose --profile debug up -d perception-api   # exposes :8090
PERCEPTION_BACKEND=sam3            # sam3 | sam2_gdino
SAM_WEIGHTS=/models/sam3
DINOV3_WEIGHTS=/models/dinov3-vitl16
SAMPLE_FPS=6                       # Tier-1 frames/sec fed to SAM 3

# ---- Offline (after weights + pip installs are cached) ------------------------
HF_HOME=/models/.hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
