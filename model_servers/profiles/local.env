# -------- local profile: RTX 5000 Ada, 32 GB --------
# Copy to ../.env :  cp profiles/local.env .env
# One large VLM (llama.cpp) + SAM 3 + DINOv3 in-memory in the backend.

MODEL_PROFILE=local

# ---- VLM (llama.cpp) : your ~27B Q4 GGUF + mmproj -----------------------------
# Edit these two to match the files you actually downloaded into models/vlm-27b/.
VLM_MODEL=/models/vlm-27b/model.Q4_K_M.gguf
VLM_MMPROJ=/models/vlm-27b/mmproj-model-f16.gguf
VLM_NGL=99            # GPU layers; lower (e.g. 60) to offload to CPU RAM and free VRAM
VLM_CTX=8192          # context window; images consume context — keep prompts terse
VLM_PARALLEL=2        # concurrent request slots

# To hot-swap to Qwen3-VL instead, repoint these at models/qwen3vl/... and
#   docker compose up -d --force-recreate vlm

# ---- Perception (in-memory, loaded by the backend) ---------------------------
PERCEPTION_BACKEND=sam3            # sam3 | sam2_gdino
SAM_WEIGHTS=/models/sam3
DINOV3_WEIGHTS=/models/dinov3
SAMPLE_FPS=6                       # Tier-1 frames/sec fed to SAM 3

# ---- Offline ------------------------------------------------------------------
HF_HOME=/models/.hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---- vLLM alternative (only if using the vllm profile) -----------------------
VLLM_MODEL=/models/qwen3vl-hf
